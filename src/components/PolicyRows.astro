---
/** トップと政策一覧に並べる五つの柱。どの行も「現状」と「取り組み」を同じ幅で並べる */
import { link } from '../config';
import { getCollection, render } from 'astro:content';
const policies = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
const rows = await Promise.all(policies.map(async (p) => ({ p, stat: p.data.stats[0], Content: (await render(p)).Content })));
---
<ol class="policy-rows">
  {rows.map(({ p, stat, Content }) => (
    <li class="policy-row">
      <div class="policy-row-num" aria-hidden="true">{p.data.numeral}</div>
      <div class="policy-row-main">
        <div class="policy-row-head">
          <h3 class="policy-row-title"><a href={link(`/policy/${p.id}/`)}>{p.data.title}</a></h3>
          <p class="policy-row-lead">{p.data.lead}</p>
        </div>
        <div class="policy-row-cols">
          {stat && (
            <div class="policy-row-col">
              <p class="mini-label">香川県の現状</p>
              <p class="policy-row-stat">
                <span class="policy-row-stat-label">{stat.label}</span>
                <strong>{stat.value}<small>{stat.unit}</small></strong>
                {stat.detail && <span class="policy-row-stat-detail">{stat.detail}</span>}
              </p>
            </div>
          )}
          <div class="policy-row-col">
            <p class="mini-label">取り組み</p>
            <div class="policy-row-text"><Content /></div>
          </div>
        </div>
        {p.data.experienceShort && (
          <p class="policy-row-exp"><span class="mini-label">経験</span>{p.data.experienceShort}</p>
        )}
        <p class="policy-row-more"><a href={link(`/policy/${p.id}/`)}>データと取り組みを詳しく見る →</a></p>
      </div>
    </li>
  ))}
</ol>
