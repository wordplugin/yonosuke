---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../config';
import portrait from '../assets/photos/portrait-robe.jpg';
import standing from '../assets/photos/portrait-temple-standing.jpg';
import ceremony from '../assets/photos/ceremony-seated.jpg';
import talk from '../assets/photos/talk-temple-smile.jpg';
import smile from '../assets/photos/smile-shirt.jpg';
import speech from '../assets/photos/speech-mic.jpg';
import lesson from '../assets/photos/lesson-screen.jpg';
---
<Base title="プロフィール" description="十河 陽之助(そごう ようのすけ)のプロフィール。寺院の運営、医療・福祉事業、11年間のPTA活動、青年会議所での地域活動に携わってきました。">
  <PageHead title="プロフィール" eyebrow="人となり" />
  <section class="section">
    <div class="wrap profile-top">
      <div class="profile-photo">
        <Image src={portrait} alt="法衣姿の十河 陽之助" widths={[400, 640, 905]} sizes="(max-width: 48rem) 18rem, 20rem" />
      </div>
      <div>
        <p class="profile-kana">{site.nameKana}</p>
        <p class="profile-name">{site.name}</p>
        <p class="profile-lead">寺院の運営、医療・福祉事業、11年間のPTA活動、青年会議所での地域活動など、幅広い分野に携わってきました。各分野で得た経験を、香川県の課題解決につなげたいと考えています。</p>
        <dl class="facts">
          <dt>生年月日</dt><dd>1976年11月19日</dd>
          <dt>学歴</dt><dd>香川県立高松北高校 卒業<br />高野山大学 文学部 仏教学科 卒業</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap history">
      <div class="history-photos">
        <Image src={smile} alt="机を囲んで笑顔で話し合う十河 陽之助" widths={[400, 808]} sizes="(max-width: 52rem) 50vw, 18rem" />
        <Image src={speech} alt="教室でマイクを手に話す十河 陽之助" widths={[400, 800]} sizes="(max-width: 52rem) 50vw, 18rem" />
      </div>
      <div>
        <div class="section-head">
          <p class="eyebrow">現在</p>
          <h2>役職</h2>
        </div>
        <ul class="roles">
          <li><span class="role-org">六萬寺</span><span class="role-title">住職</span></li>
          <li><span class="role-org">四国八十八ヶ所霊場 第86番札所 志度寺</span><span class="role-title">副住職</span></li>
          <li><span class="role-org">四国八十八ヶ所霊場 第62番札所 宝寿寺</span><span class="role-title">副住職</span></li>
          <li><span class="role-org">一般社団法人 四国八十八ヶ所霊場会</span><span class="role-title">理事</span></li>
          <li><span class="role-org">NPO法人 お遍路とおもてなしのネットワーク</span><span class="role-title">理事</span></li>
          <li><span class="role-org">医療法人社団 彰志会 介護老人保健施設 ポタラの森</span><span class="role-title">理事</span></li>
          <li><span class="role-org">香川大学附属高松小学校 しらうめ会<small>PTA活動歴11年</small></span><span class="role-title">会長</span></li>
        </ul>

        <div class="section-head" style="margin-top:3.5rem">
          <p class="eyebrow">歩み</p>
          <h2>主な役職歴</h2>
        </div>
        <ul class="roles">
          <li><span class="role-org">公益社団法人 高松青年会議所</span><span class="role-title">理事長</span></li>
          <li><span class="role-org">公益社団法人 日本青年会議所</span><span class="role-title">四国地区会長</span></li>
          <li><span class="role-org">香川大学附属幼稚園高松園舎 わかうめ会</span><span class="role-title">会長</span></li>
          <li><span class="role-org">四国遍路の心でつなぐ防災研究会</span><span class="role-title">会長</span></li>
          <li><span class="role-org">一般社団法人 四国八十八ヶ所霊場会 青年会</span><span class="role-title">会長</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="photo-grid">
        <Image src={standing} alt="寺で法衣姿で微笑む様子" widths={[480, 800]} sizes="(max-width: 40rem) 100vw, 33vw" />
        <Image src={talk} alt="寺で地域の皆さまに話す様子" widths={[480, 800]} sizes="(max-width: 40rem) 100vw, 33vw" />
        <Image src={ceremony} alt="屋外の法要に臨む様子" widths={[480, 800]} sizes="(max-width: 40rem) 100vw, 33vw" />
        <Image src={lesson} alt="寺を訪れた子どもたちに話す様子" widths={[480, 800]} sizes="(max-width: 40rem) 100vw, 33vw" />
      </div>
    </div>
  </section>
</Base>
